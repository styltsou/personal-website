---
import '../styles/index.scss';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Portfolio Website',
  description = 'A retro 90s-themed portfolio website',
  image = '/favicon.svg',
} = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || Astro.url.origin
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content={new URL(image, canonicalURL).toString()}
    />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL.toString()} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta
      property="twitter:image"
      content={new URL(image, canonicalURL).toString()}
    />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL.toString()} />

    <!-- View Transitions API -->
    <script>
      import('astro:transitions/client');
    </script>

    <!-- Dynamic title change when window loses focus -->
    <script define:inline>
      (function () {
        // Store the original title - capture it after page loads
        let originalTitle = '';
        let isTitleCaptured = false;

        // Capture the original title when available
        function captureOriginalTitle() {
          if (!isTitleCaptured && document.title) {
            originalTitle = document.title;
            isTitleCaptured = true;
          }
        }

        // Initialize: try to capture title immediately or wait for load
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
          // Use setTimeout to ensure title is set by browser
          setTimeout(captureOriginalTitle, 0);
        } else {
          window.addEventListener('load', captureOriginalTitle);
          // Also try on DOMContentLoaded as fallback
          document.addEventListener('DOMContentLoaded', captureOriginalTitle);
        }

        // Function to restore original title
        function restoreTitle() {
          if (!isTitleCaptured) {
            captureOriginalTitle();
          }
          if (originalTitle) {
            document.title = originalTitle;
          }
        }

        // Function to change title when window loses focus
        function changeTitleOnBlur() {
          if (!isTitleCaptured) {
            captureOriginalTitle();
          }
          document.title = 'miss you already';
        }

        // Listen for window blur/focus events
        window.addEventListener('blur', changeTitleOnBlur);
        window.addEventListener('focus', restoreTitle);

        // Also handle visibility change (for mobile/tab switching)
        document.addEventListener('visibilitychange', function () {
          if (document.hidden) {
            changeTitleOnBlur();
          } else {
            restoreTitle();
          }
        });
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family:
      -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu,
      Cantarell, 'Helvetica Neue', sans-serif;
    font-size: 11px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  * {
    box-sizing: border-box;
  }
</style>
