---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactContent from '../components/content/contact-content.astro';

// Mark as prerendered for static generation and SEO
export const prerender = true;

const site = Astro.site?.href || 'https://styltsou.com';
const canonicalURL = new URL('/contact', site);
---

<BaseLayout
  title="contact - styltsou"
  description="Get in touch with me through email, social media, or other channels. I'd love to hear from you!"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Contact - styltsou",
    "description": "Get in touch with me through email, social media, or other channels. I'd love to hear from you!",
    "url": canonicalURL.toString(),
    "inLanguage": "en"
  })} />
  <ContactContent />
</BaseLayout>
