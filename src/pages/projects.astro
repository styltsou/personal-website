---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Projects - Portfolio"
  description="Browse my portfolio of projects and work"
>
  <main class="mx-auto max-w-4xl p-6">
    <h1 class="mb-4 text-3xl font-bold">Projects</h1>
    <div class="prose prose-lg">
      <p>
        This page showcases my projects and work. Each project would be listed
        here with descriptions, technologies used, and links.
      </p>
      <section class="mt-8">
        <h2 class="mb-4 text-2xl font-semibold">Featured Projects</h2>
        <ul class="list-inside list-disc space-y-2">
          <li>Project One - Description here</li>
          <li>Project Two - Description here</li>
          <li>Project Three - Description here</li>
        </ul>
      </section>
    </div>
  </main>
</BaseLayout>
