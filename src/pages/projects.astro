---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectsContent from '../components/content/projects-content.astro';

// Mark as prerendered for static generation and SEO
export const prerender = true;

const site = Astro.site?.href || 'https://styltsou.com';
const canonicalURL = new URL('/projects', site);
---

<BaseLayout
  title="projects - styltsou"
  description="Explore my featured projects, web applications, and creative work. See what I've built and the technologies I use."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Projects - styltsou",
    "description": "Explore my featured projects, web applications, and creative work. See what I've built and the technologies I use.",
    "url": canonicalURL.toString(),
    "inLanguage": "en"
  })} />
  <ProjectsContent />
</BaseLayout>
