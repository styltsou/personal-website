---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutContent from '../components/content/about-content.astro';

// Mark as prerendered for static generation and SEO
export const prerender = true;

const site = Astro.site?.href || 'https://styltsou.com';
const canonicalURL = new URL('/about', site);
---

<BaseLayout
  title="about me - styltsou"
  description="Learn more about my background, skills, and experience as a developer and creator."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "About Me - styltsou",
    "description": "Learn more about my background, skills, and experience as a developer and creator.",
    "url": canonicalURL.toString(),
    "inLanguage": "en"
  })} />
  <AboutContent />
</BaseLayout>
