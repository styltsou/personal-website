---
import BaseLayout from '../layouts/BaseLayout.astro';

// Mark as prerendered for static generation and SEO
export const prerender = true;

const site = Astro.site?.href || 'https://styltsou.com';
const canonicalURL = new URL('/about', site);
---

<BaseLayout
  title="about me - styltsou"
  description="Learn more about my background, skills, and experience as a developer and creator."
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'About Me - styltsou',
      description:
        'Learn more about my background, skills, and experience as a developer and creator.',
      url: canonicalURL.toString(),
      inLanguage: 'en',
    })}
  />
  <main class="mx-auto max-w-4xl p-6">
    <h1 class="mb-4 text-3xl font-bold">About Me</h1>
    <div class="prose prose-lg">
      <p>
        Welcome to my portfolio website! This is a static page that demonstrates
        the SEO-friendly content structure.
      </p>
      <p>
        Here you would add your biography, skills, experience, and anything else
        you'd like visitors to know about you.
      </p>
    </div>
  </main>
</BaseLayout>
