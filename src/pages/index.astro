---
import BaseLayout from '../layouts/BaseLayout.astro';
import Desktop from '../components/desktop';
import { getContentApps } from '../utils/get-content-data';
import { readFile } from 'fs/promises';
import { join } from 'path';

// Extract content from source pages at build time for SEO and performance
const contentApps = getContentApps();
const contentData: Record<string, string> = {};

// Map app IDs to their page file paths
const pageMap: Record<string, string> = {
  about: 'about.astro',
  projects: 'projects.astro',
  contact: 'contact.astro',
};

// Read content from source page files
for (const app of contentApps) {
  try {
    const pageFile = pageMap[app.id];
    if (pageFile) {
      const pagePath = join(process.cwd(), 'src', 'pages', pageFile);
      const source = await readFile(pagePath, 'utf-8');
      // Extract main content from the source file using regex
      const mainMatch = source.match(/<main[^>]*>([\s\S]*?)<\/main>/i);
      if (mainMatch) {
        contentData[app.id] = mainMatch[1].trim();
      }
    }
  } catch (error) {
    // If file doesn't exist, content will be fetched at runtime
    console.warn(`Could not extract content for ${app.id} at build time:`, error);
  }
}

// Static content is available for SEO even before JS loads
---

<BaseLayout
  title="styltsou - home"
  description="Personal portfolio website featuring an 80s-inspired desktop OS interface. Explore my work, projects, and get in touch."
>
  <!-- Embed content data for instant access (SEO-friendly) -->
  <script define:inline>
    // Embed content data in initial HTML for instant access and SEO
    // Only includes content from path-based apps (about, projects, contact)
    window.__CONTENT_DATA__ = JSON.stringify(contentData);
  </script>

  <!-- Desktop component as React island - loads when idle for better performance -->
  <Desktop client:idle />

  <!-- Fallback static content for progressive enhancement -->
  <noscript>
    <div class="mx-auto max-w-4xl p-6">
      <h1 class="mb-4 text-3xl font-bold">Portfolio Website</h1>
      <p class="mb-4">
        Welcome to my portfolio! JavaScript is required for the interactive
        window manager.
      </p>
      <nav class="space-y-2">
        <a href="/about" class="text-blue-600 hover:underline">About Me</a>
        <br />
        <a href="/projects" class="text-blue-600 hover:underline">Projects</a>
        <br />
        <a href="/contact" class="text-blue-600 hover:underline">Contact</a>
      </nav>
    </div>
  </noscript>
</BaseLayout>
